# Copy to .env (same directory as docker-compose.yml) before the first run:
#
#   cp .env.example .env
#
# THIS FILE IS FOR COMPOSE, NOT FOR THE APPLICATION. Compose reads only the
# .env sitting next to docker-compose.yml, and only for the ${...} placeholders
# inside it. backend/.env is a different file with a different job: it is
# mounted into the backend container and read by the app. Neither one can stand
# in for the other, and a variable written into the wrong one is simply unset.
#
# Nothing here is required for `docker compose up --build` — every placeholder
# has a working default. The file exists so a fork can see what is adjustable.
#
# Never write a real credential into .env.example. It IS committed.

# ---------------------------------------------------------------------------
# Bundled Postgres  (only started by `docker compose --profile local-db up`)
#   Used by the db container as its superuser password, and it must match the
#   password inside DATABASE_URL in backend/.env, since that is what the
#   backend connects with:
#
#     DATABASE_URL=postgresql+psycopg2://jaikvin:<same value>@db:5432/jaikvin
#
#   Generate one rather than typing a word:
#     python3 -c "import secrets;print(secrets.token_urlsafe(24))"
#
#   Leave it blank if the local database is not used — the placeholder is
#   deliberately not marked required, so an unset value costs a fork nothing
#   until it actually asks for the local-db profile.
#
#   Changing it after the first run does NOT change the password: it was
#   written into the pgdata volume at initialisation. Either set it back, or
#   drop the volume and start over (`docker compose down -v`, which erases
#   whatever is in the local database).
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Host ports. Containers always listen on 8000 (backend) and 8080 (frontend);
# only the host side moves. Defaults avoid 8000/8080, which are commonly taken
# ("port is already allocated").
# ---------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=8090
