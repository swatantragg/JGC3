# Copy to .env and adjust for your environment.
# docker-compose mounts this file into the container, so one copy serves both
# `python run.py` and `docker compose up`.

# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./jaikvin.db

# Postgres — bundled container (docker compose --profile local-db up):
# DATABASE_URL=postgresql+psycopg2://jaikvin:jaikvin@db:5432/jaikvin
# Postgres — hosted (Neon and similar require sslmode=require):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8090

# Signs session tokens. GENERATE A REAL ONE before deploying — anyone holding
# it can mint a valid login for any account:  openssl rand -hex 32
JWT_SECRET=change-me
# 24 hours — a session expires a day after sign-in, for users and admins alike.
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Email verification (one-time passcode)
#   user  -> mailed a code on their FIRST sign-in only; verified for good after
#   admin -> mailed a code whenever the last one is older than 24h (per session)
# ---------------------------------------------------------------------------
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_ADMIN_REVERIFY_HOURS=24
# Development only — returns the code in the API response. Keep false in production.
OTP_DEV_ECHO=false

# Gmail SMTP. SMTP_PASSWORD is a 16-character Google App Password (Google
# account -> Security -> 2-Step Verification -> App passwords), never the
# Gmail password itself. Leave SMTP_HOST blank to print the code to the server
# log instead of mailing it (local development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=your.account@gmail.com
SMTP_FROM_NAME=Jaikvin Global Export System

# ---------------------------------------------------------------------------
# Admin password screen (Setup -> Users -> click an account)
#   Only an admin may read a password back or set one, and only just after
#   answering an emailed code. Reading one back means a reversible copy is
#   stored alongside the bcrypt hash — see app/vault.py. Anyone holding BOTH
#   the database and this key can read every password, so treat a dump as
#   sensitive as the key itself.
#   Blank derives the key from JWT_SECRET. Generate a real one:
#     openssl rand -hex 32
#   Changing either makes previously stored copies unreadable — accounts then
#   read as "not recoverable" until their password is set again.
# ---------------------------------------------------------------------------
PASSWORD_VAULT_KEY=
# How long one emailed confirmation covers password work, in minutes.
STEPUP_TTL_MINUTES=10

# Dev server bind — change API_PORT to switch ports (run: python run.py).
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true
