# Copy to .env and adjust for your environment.
#
# FOR LOCAL DEVELOPMENT ONLY. In production set these names in the host's own
# secret store — Render's Environment tab, Docker secrets — and mount no file.
# A file gets copied into images, backed up, and pasted into chat windows; a
# secret that has been in one has to be assumed known.
#
# Never write a real credential into this example file. It IS committed.

# "production" closes /docs, sends HSTS, forces Secure cookies, and refuses to
# start if JWT_SECRET is a placeholder. Anything else counts as development.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Which database this process talks to. There is no syncing between the three
# options below — whichever is set here receives every write, and the other two
# never learn about it.
#
# THE TEAM WORKS AGAINST THE HOSTED NEON POSTGRES, in development as well as in
# production, so a change made locally is immediately visible to everyone and to
# the deployed site. Get the URL from the Neon console (or from whoever set the
# project up) and paste it here — it is not in this file, because this file is
# committed. Neon requires sslmode=require:
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# What that choice means, so it is a decision and not a surprise:
#   - there is no separate dev copy. A migration, an `import_masters.py` run or
#     a deletion made while testing lands on the data the business uses.
#   - two people working at once share one schema and one set of rows.
#   - the first request after a quiet spell takes a few seconds while Neon wakes
#     the endpoint; app/database.py is configured for that.
# Neon's branching feature gives a copy-on-write branch with its own URL if an
# isolated database is ever wanted without giving up Postgres.

# SQLite — zero-config scratch file, nothing shared, nothing at risk. Point here
# for anything experimental:
# DATABASE_URL=sqlite:///./jaikvin-dev.db

# Postgres — bundled container (docker compose --profile local-db up).
# The password goes in ../.env (the compose one, copied from ../.env.example),
# NOT here — compose never reads this file — and the same value is repeated in
# the URL below, because that is what the backend connects with.
# DATABASE_URL=postgresql+psycopg2://jaikvin:SAME_AS_POSTGRES_PASSWORD@db:5432/jaikvin
# Postgres — hosted (Neon and similar require sslmode=require):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated browser origins allowed to call the API. Also checked by the
# origin guard in app/main.py on every write, so a missing entry here shows up
# as a 403 on POST rather than as a CORS message.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8090

# Signs session tokens. GENERATE A REAL ONE before deploying — anyone holding
# it can mint a valid login for any account, without a password or a passcode:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The app will not start with this value when ENVIRONMENT=production.
JWT_SECRET=change-me
# 24 hours — a session expires a day after sign-in, for users and admins alike.
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Session cookie
#   The session travels in an httpOnly cookie and is never handed to page
#   JavaScript — a token the page can read is a token an injected script can
#   read, and one stolen admin session is the whole system.
#
#   SameSite=lax is correct whenever the browser sees the API as same-origin,
#   which is what the /api rewrite in frontend/vercel.json arranges. It is also
#   what blocks the cross-site POST that CSRF depends on. Use "none" only if
#   the browser is made to call the backend host directly; it requires Secure,
#   and CSRF then rests on the origin guard alone.
# ---------------------------------------------------------------------------
COOKIE_SAMESITE=lax
COOKIE_SECURE=false          # true in production; http://localhost needs false

# ---------------------------------------------------------------------------
# Sign-in failures
#   Soft: this many failures in a row locks the account for a few minutes, then
#         it opens by itself. Covers the ordinary mistyped password.
#   Hard: this many inside the window is not a typo, and waits for a human.
#   Either can be cleared by the account holder answering a code at their own
#   address — a lock only an admin can lift is a weapon anyone can point at an
#   account they know the address of.
# ---------------------------------------------------------------------------
LOCKOUT_SOFT_THRESHOLD=5
LOCKOUT_SOFT_MINUTES=15
LOCKOUT_HARD_THRESHOLD=10
LOCKOUT_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Rate limits — "count/window", window as 30s / 15m / 1h.
#   Per-account limits are the tight ones: they hold however many addresses the
#   traffic arrives from, so a botnet buys nothing. Per-IP limits are loose on
#   purpose — one office shares one public address, and locking out twenty
#   people because one of them fumbled is not security.
#   Counted in the database, not in memory: Render's free tier stops the
#   container when it is quiet, and an in-process counter would come back empty.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RL_LOGIN_IP=40/15m
RL_OTP_VERIFY_ACCOUNT=10/5m
RL_OTP_SEND_ACCOUNT=5/1h
RL_OTP_SEND_IP=20/1h
RL_PASSWORD_ADMIN=10/1h
RL_UNLOCK_ACCOUNT=5/1h
RL_API_USER=300/1m
RL_API_IP=900/1m
RL_PUBLIC_IP=60/1m

# How many previous passwords a new one is checked against, to stop the
# change-then-change-straight-back move. Deliberately not paired with an
# expiry date: scheduled rotation produces Summer2025! followed by Summer2026!
# and a note under the keyboard, which NIST 800-63B advises against.
PASSWORD_HISTORY_SIZE=3

# ---------------------------------------------------------------------------
# Email verification (one-time passcode)
#   user  -> mailed a code on their FIRST sign-in only; verified for good after
#   admin -> mailed a code whenever the last one is older than 24h (per session)
# ---------------------------------------------------------------------------
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_ADMIN_REVERIFY_HOURS=24
OTP_ADMIN_REVERIFY_MODE=midnight
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# How the passcode is sent.
#   smtp   — smtplib. Right locally and in Docker.
#   brevo  — HTTPS POST to api.brevo.com     (MAIL_API_KEY = your v3 key)
#   resend — HTTPS POST to api.resend.com    (MAIL_API_KEY = re_...)
#
# Most managed hosts (Render, Vercel and others) silently DROP outbound packets
# on the SMTP ports to stop spam abuse, so smtplib hangs until it times out and
# the send fails with credentials that are perfectly good. The tell is the
# timing: a wrong password is refused in under a second, a blocked port takes
# the whole SMTP_TIMEOUT. Port 443 is never blocked — use an email API there.
#
# With brevo/resend, SMTP_FROM is the sender address (verify it with the
# provider first) and SMTP_FROM_NAME the display name. The SMTP_* host, user
# and password are ignored.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_API_KEY=

# Gmail SMTP. SMTP_PASSWORD is a 16-character Google App Password (Google
# account -> Security -> 2-Step Verification -> App passwords), never the
# Gmail password itself. Leave SMTP_HOST blank to print the code to the server
# log instead of mailing it (local development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=your.account@gmail.com
SMTP_FROM_NAME=Jaikvin Global Export System

# ---------------------------------------------------------------------------
# Admin password screen (Setup -> Users -> click an account)
#   A password CANNOT be read back. Only a bcrypt hash is stored, which is
#   one-way by design, so a database dump is not a credential dump.
#
#   There used to be a PASSWORD_VAULT_KEY here, encrypting a second reversible
#   copy of every password so an admin could reveal one. It is gone, and the
#   column with it: people reuse passwords, so that copy put their mail and
#   their bank at risk as well as this system.
#
#   Restoring access to a forgotten account now means setting a new password.
#   The holder is made to replace it at their next sign-in, so the one the
#   admin typed works exactly once. Setting it still needs an emailed code
#   answered minutes before — a session left open on an unlocked machine is
#   not enough on its own.
# ---------------------------------------------------------------------------
# How long one emailed confirmation covers password work, in minutes.
STEPUP_TTL_MINUTES=10

# Dev server bind — change API_PORT to switch ports (run: python run.py).
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true
