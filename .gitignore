# Root .gitignore — monorepo-wide only.
# Stack-specific rules live in backend/.gitignore, frontend/.gitignore, prototype2/.gitignore.
# Do NOT add unanchored generic names here (lib/, build/, dist/, var/, env/) —
# they match at any depth and silently swallow real source (see frontend/src/lib).

# Secrets — safety net at every level
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
logs/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.swp
*.swo

# Office / LibreOffice lock files
.~lock.*#
~$*

# Docker local overrides
docker-compose.override.yml
    